# ============================================================
# BB200 Pro - 환경변수 설정 파일
# 이 파일을 복사하여 .env로 저장하세요
# cp .env.example .env
# ============================================================

# ── Bitget API 설정 ──────────────────────────────────────────
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_passphrase_here

# ── 거래 모드 ────────────────────────────────────────────────
# PAPER = 모의투자 (기본값, 안전)
# LIVE  = 실거래 (API 키 필요)
TRADING_MODE=PAPER

# ── 거래 종목 ────────────────────────────────────────────────
SYMBOL=BTC/USDT:USDT

# ── 레버리지 / 리스크 설정 ───────────────────────────────────
LEVERAGE=5
MAX_POSITION_SIZE_USDT=1000
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=10
INITIAL_PAPER_BALANCE=10000

# ── 전략 파라미터 ────────────────────────────────────────────
BB_PERIOD=200
BB_STD=2.0
TARGET_MOVE_PCT=1.8
TRAILING_STOP_PCT=0.7
COOLDOWN_BARS=6

# ── 수수료 설정 (Bitget 기본값) ──────────────────────────────
TAKER_FEE_PCT=0.06
MAKER_FEE_PCT=0.02
FUNDING_RATE_PCT=0.01

# ── 텔레그램 알림 설정 ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=false

# ── 서버 설정 ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
